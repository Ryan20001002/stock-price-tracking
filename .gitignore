# Python cache/bytecode
__pycache__/
*.pyc
*.pyo

# Virtual environments, if you ever create one
.venv/
venv/
env/

# OS clutter
.DS_Store
Thumbs.db

# Stray duplicate files that ended up saved alongside the real project --
# safe to delete manually; kept out of git either way as a safety net.
Claude outputs/

# Fetched/generated data -- this is output the scripts (re)create by
# running main.py, price_data.py, etc., not source code. Excluded by
# default so the repo stays small and doesn't fill up with CSVs over
# time. Delete this line (or move it below a `data/.gitkeep` exception)
# if you'd rather snapshot your data in the repo too -- there's nothing
# wrong with that for a dissertation project where reproducibility of a
# specific dataset matters. This also covers data/users.json (login
# accounts + personal watchlists, see user_store.py) -- IMPORTANT that
# this one in particular never gets committed, since it holds password
# hashes, even though they're salted/hashed rather than plain text.
data/

# Streamlit secrets -- API tokens, keys, etc. NEVER commit this file.
# (2026-09-11) Now actually used again: user_store.py's optional
# GitHub-backed account storage reads a GitHub Personal Access Token from
# here (see .streamlit/secrets.toml.example for the format). The .example
# file is intentionally NOT excluded below -- it holds no real secret, and
# is meant to be committed as a template for whoever sets this up.
.streamlit/secrets.toml
