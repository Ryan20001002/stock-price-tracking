# Copy this file to .streamlit/secrets.toml (same folder) and fill in
# real values there -- secrets.toml itself is gitignored and must NEVER be
# committed. This .example file has no real secret in it, so it's safe to
# keep in the repo as a template.
#
# ----------------------------------------------------------------------
# [github_data] -- OPTIONAL. Only needed if you want any of the
# following to actually PERSIST when this app is deployed on Streamlit
# Community Cloud:
#   - account data (data/users.json: usernames, password hashes,
#     personal watchlists)
#   - the shared ticker registry (data/watchlist.json: which stock codes
#     the app tracks at all)
#   - the actual FETCHED market data (data/prices, data/dividends,
#     data/institutional, data/market_value, data/news -- everything the
#     "更新資料" sidebar buttons and `python main.py` produce)
#
# Why this is needed at all: Streamlit Community Cloud rebuilds the app's
# container from GitHub on every redeploy and after the app "sleeps" from
# inactivity -- anything not tracked in git (like data/, which is
# gitignored on purpose, see .gitignore) gets wiped each time. Without
# this section, user_store.py/config.py/market_data_sync.py all just use
# local files instead, which is fine when running locally (streamlit run
# app.py on your own computer -- the files persist on disk like any
# other file) but means accounts, added tickers, AND every fetched CSV
# all get wiped on Streamlit Cloud. Losing the fetched market data is by
# far the most expensive of the three to regenerate -- a full
# 三大法人/institutional backfill alone can take an hour or more of
# rate-limited TWSE requests, and it was found (2026-09-11) to complete
# successfully and still vanish once the container was later recycled.
#
# With this section filled in, all of the above are instead read/written
# inside a SEPARATE, PRIVATE GitHub repo via GitHub's API -- one section,
# same token/repo, different files/folders in it (`path` for accounts,
# `watchlist_path` for the ticker registry, `market_data_prefix` for the
# fetched CSVs) -- so everything persists across restarts/redeploys no
# matter where the app runs. See user_store.py's, config.py's, and
# market_data_sync.py's module docstrings for the full design; the
# actual GitHub read/write code lives in github_json_store.py, shared by
# all three.
#
# The market data specifically is pushed once at the END of each fetch
# script's run (not after every incremental checkpoint, to avoid adding
# GitHub round-trips throughout an already rate-limited hour-long
# backfill), and pulled back down once per running container at startup
# -- so a fresh/restarted container automatically restores whatever was
# last successfully pushed, instead of showing empty tables. This also
# means running a big backfill locally (`python institutional_data.py`
# or `python main.py --institutional`, as already recommended in those
# files' docstrings for other reasons) now also backs it up -- the
# deployed app will pick it up automatically next time it starts,
# without ever needing to repeat the backfill on Cloud itself.
#
# Setup steps:
#   1. Create a NEW, PRIVATE GitHub repo just for this data (e.g.
#      "stock-tracker-data") -- do NOT reuse this app's own code repo,
#      especially if that one is public: writing password hashes into a
#      public repo's history defeats the point of hashing them.
#   2. On github.com: profile picture (top right) -> Settings ->
#      Developer settings -> Personal access tokens -> Fine-grained
#      tokens -> "Generate new token".
#   3. Under "Repository access", choose "Only select repositories" and
#      pick ONLY the private data repo from step 1 -- not this code repo,
#      not "All repositories".
#   4. Under "Permissions" -> "Repository permissions", set
#      "Contents" to "Read and write". Leave everything else as "No
#      access".
#   5. Generate the token and copy it immediately (GitHub only shows it
#      once). Paste it as `token` below.
#   6. Fill in `repo` as "your-github-username/your-private-repo-name".
#   7. Locally: paste this whole filled-in section into a real
#      .streamlit/secrets.toml file (create the file if it doesn't
#      exist) -- NOT this .example file.
#   8. On Streamlit Community Cloud: open this app -> Settings -> Secrets
#      -> paste the same filled-in section there (same TOML format) ->
#      Save. The app will reboot automatically and pick it up.
#
# [github_data]
# token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# repo = "your-github-username/your-private-data-repo"
# path = "users.json"                     # optional, this is the default if omitted
# watchlist_path = "watchlist.json"       # optional, this is the default if omitted
# market_data_prefix = "market_data"      # optional, this is the default if omitted
#
# If you already set this section up before 2026-09-11 (just `token`,
# `repo`, maybe `path`), nothing breaks -- `watchlist_path` and
# `market_data_prefix` simply default to "watchlist.json" and
# "market_data" in the SAME repo you already created, so there's nothing
# extra to do. Both get created automatically -- watchlist.json the
# first time anyone adds a brand-new ticker, and market_data/ the first
# time any fetch button (or `python main.py`/a standalone fetch script)
# successfully finishes after this update.
#
# NOTE on repo size: the fetched CSVs (especially institutional data,
# one file per ticker, up to years of daily rows) will make this private
# repo grow larger than it did when it only held users.json/
# watchlist.json. Each push also adds a commit. Neither is a problem for
# a small dissertation-project watchlist, but if you ever track a very
# large number of tickers, it's worth keeping an eye on the repo's size
# on github.com.
