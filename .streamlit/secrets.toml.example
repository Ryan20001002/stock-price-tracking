# Template for .streamlit/secrets.toml -- copy this file to
# .streamlit/secrets.toml (same folder) and fill in your real values.
# secrets.toml itself is gitignored and must NEVER be committed; this
# .example file has no real secrets in it, so it's safe to keep in git as
# a reference for "what goes where."
#
# Full setup steps (Google Cloud OAuth client, Google Sheet + service
# account) are in the README's "Login and personal watchlists" section.

[auth]
# Local development: keep this pointed at localhost.
# On Streamlit Community Cloud, change this (in the deployed app's own
# Secrets settings, NOT in this file) to your deployed app's URL, e.g.
# "https://your-app-name.streamlit.app/oauth2callback"
redirect_uri = "http://localhost:8501/oauth2callback"

# Any long random string -- generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET"

# From your Google Cloud OAuth 2.0 Client (Credentials page)
client_id = "REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_SECRET"

# Standard for Google -- same for every app, don't change this one
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"


[gsheets]
# The long ID in your Google Sheet's URL, between "/d/" and "/edit"
# e.g. for https://docs.google.com/spreadsheets/d/1AbCdEfG.../edit
# the spreadsheet_id is "1AbCdEfG..."
spreadsheet_id = "REPLACE_WITH_YOUR_SPREADSHEET_ID"


[gcp_service_account]
# Paste every field from the JSON key file you downloaded when creating
# your Google Sheets service account. Example shape (your real values
# will look like this, but with real data instead of "xxx"):
type = "service_account"
project_id = "xxx"
private_key_id = "xxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
client_email = "xxx@xxx.iam.gserviceaccount.com"
client_id = "xxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "xxx"
